#!/usr/bin/env bash
# Every push is scanned for secrets and personal data before it leaves: Brick by Brick's tools/secret_scan.py,
# called by absolute path with --repo (this public repo keeps no copy of the rules).
# Installed by: git config core.hooksPath .githooks
# Another location for the scanner: git config brick.appScanner <path to secret_scan.py>
# Fails closed: no scanner, no Python, or a scan that cannot run = no push. Never bypass with --no-verify.
ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$(git config brick.appScanner)"
if [ -z "$SCANNER" ]; then
  for c in C:/Users/telld/.claude/bbb-app "$HOME/.claude/bbb-app"; do
    [ -f "$c/tools/secret_scan.py" ] && SCANNER="$c/tools/secret_scan.py" && break
  done
fi
ZERO=0000000000000000000000000000000000000000
if [ ! -f "$SCANNER" ]; then
  echo "pre-push: the secret scanner was not found -- refusing the push."
  echo "  git config brick.appScanner <path to tools/secret_scan.py>"
  exit 1
fi
PY=$(command -v python || command -v python3) || { echo "pre-push: no Python -- refusing the push."; exit 1; }
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$local_sha"                     # a new branch or tag: all of it
  fi
  "$PY" "$SCANNER" --push "$range" --repo "$ROOT" < /dev/null || status=1
done
exit $status
